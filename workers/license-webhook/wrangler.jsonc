{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Sandbox / test-mode Worker only. Live Phase B should use a separate
  // production name (e.g. overwire-license-webhook) with live secrets.
  "name": "overwire-license-webhook-sandbox",
  "main": "worker.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "vars": {
    "LICENSE_MAIL_FROM": "overwire@protovoid.com",
    "LICENSE_KEY_PREFIX": "OWPRO",
    // Sandbox E2E only — never set on a production Worker. When "1",
    // checkout.session.completed JSON includes licenseKey for agent verify.
    "SANDBOX_ECHO_LICENSE": "1"
  }
}
