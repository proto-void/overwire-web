---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../../site.config';
import { breadcrumbLd } from '../../lib/seo';

const title = `Overwire vs Resource Override · ${siteConfig.name}`;
const description =
  'Side-by-side comparison: Overwire is an MIT Manifest V3 rewrite inspired by Resource Override — local redirects, mocks, API Tester, and Databases, with no Overwire cloud.';

type Cell = string;

const rows: { aspect: string; overwire: Cell; ro: Cell }[] = [
  {
    aspect: 'Extension model',
    overwire: 'Manifest V3; maintained Chrome path (declarativeNetRequest)',
    ro: 'Classic Manifest V2 Resource Override',
  },
  {
    aspect: 'License',
    overwire: 'MIT (proto-void/overwire)',
    ro: 'Original Resource Override project (separate codebase)',
  },
  {
    aspect: 'Cloud / account',
    overwire: 'Local-only. No account. No Overwire server.',
    ro: 'Local rules on your device (no Overwire-style cloud)',
  },
  {
    aspect: 'Redirect URLs',
    overwire: 'Yes',
    ro: 'Yes',
  },
  {
    aspect: 'Modify headers / block',
    overwire: 'Yes',
    ro: 'Yes',
  },
  {
    aspect: 'Inject JS / CSS',
    overwire: 'Yes',
    ro: 'Yes',
  },
  {
    aspect: 'Mock fetch / XHR',
    overwire: 'Yes',
    ro: 'Yes',
  },
  {
    aspect: 'Replace response body',
    overwire: 'Yes (debugger / filter paths; optional Local Bridge for disk)',
    ro: 'Yes (including classic file override)',
  },
  {
    aspect: 'Rule tester',
    overwire: 'Yes — paste a URL and see which rule wins',
    ro: 'Rules editor only (no Overwire-style tester)',
  },
  {
    aspect: 'Match log',
    overwire: 'Yes — recent matches on your device',
    ro: 'Not the Overwire session match log',
  },
  {
    aspect: 'Starter recipes',
    overwire: 'Yes (localhost, CORS, SPA helpers)',
    ro: 'No Overwire recipes pack',
  },
  {
    aspect: 'API Tester',
    overwire: 'Yes — local HTTP client (collections, environments, history)',
    ro: 'No',
  },
  {
    aspect: 'Databases workbench',
    overwire: 'Yes — local explorer/queries via optional Overwire Helper',
    ro: 'No',
  },
  {
    aspect: 'Local Bridge (file serve)',
    overwire: 'Yes — optional CLI serves a folder on loopback',
    ro: 'File override from disk (different model; no Overwire Bridge)',
  },
  {
    aspect: 'Import Resource Override exports',
    overwire: 'Yes — import common RO export formats',
    ro: 'Native export / import of its own formats',
  },
  {
    aspect: 'Browsers',
    overwire: 'Chrome Web Store live; Edge / Firefox builds exist (store listings may lag)',
    ro: 'Depends on the original extension build and browser policy',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/vs-resource-override/"
  jsonLd={breadcrumbLd([
    { name: 'Home', path: '/' },
    { name: 'vs Resource Override', path: '/vs-resource-override/' },
  ])}
>
  <main class="vs">
    <div class="wrap vs__inner">
      <header class="vs__head">
        <p class="vs__eyebrow">Comparison</p>
        <h1>Overwire as a Resource Override alternative</h1>
        <p class="vs__lede">
          Looking for a <strong>Resource Override alternative</strong> on modern Chrome? Overwire is an
          MIT-licensed rewrite inspired by Resource Override, built for Manifest V3. Same idea: point
          production at localhost or mocks without a proxy appliance. Overwire also adds a local API
          Tester and Databases workbench. Still no account and no Overwire server.
        </p>
      </header>

      <div class="vs__table-wrap" role="region" aria-labelledby="compare-caption" tabindex="0">
        <table class="vs__table">
          <caption id="compare-caption" class="vs__caption">
            Side-by-side feature comparison of Overwire and Resource Override
          </caption>
          <thead>
            <tr>
              <th scope="col">Aspect</th>
              <th scope="col">Overwire</th>
              <th scope="col">Resource Override</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row) => (
                <tr>
                  <th scope="row">{row.aspect}</th>
                  <td>{row.overwire}</td>
                  <td>{row.ro}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="prose">
        <h2>When to choose Overwire</h2>
        <p>
          Choose Overwire if you need a maintained Chrome path to redirect requests and override
          responses locally — mock APIs, point CDNs at localhost, inject debug scripts — and you want
          the same extension to carry a local API Tester and Databases workbench, without running
          Charles/Fiddler or trusting a cloud rewrite service.
        </p>
        <p>
          Prefer staying on the original Resource Override build if that extension still meets your
          browser and policy needs. This page is an honest comparison, not a claim that every legacy
          MV2 detail is identical.
        </p>

        <p class="vs__cta">
          <a class="btn btn--primary" href={siteConfig.github}>View source on GitHub</a>
          <a class="btn btn--ghost" href="/">Product home</a>
          <a class="btn btn--ghost" href="/changelog/">Changelog</a>
        </p>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .vs {
    padding: clamp(3rem, 8vh, 5rem) 0 var(--space-8);
  }

  .vs__inner {
    max-width: min(52rem, 100%);
  }

  .vs__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--accent);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .vs__head h1 {
    margin: 0 0 var(--space-4);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .vs__lede {
    margin: 0 0 var(--space-6);
    color: var(--text-2);
    font-size: var(--text-lg);
  }

  .vs__table-wrap {
    margin: 0 0 var(--space-7);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--border);
    background: var(--surface);
    outline-offset: 3px;
  }

  .vs__caption {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    color: var(--text-2);
    font-size: var(--text-sm);
    border-bottom: 1px solid var(--border);
  }

  .vs__table {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .vs__table th,
  .vs__table td {
    padding: 0.85rem var(--space-4);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
  }

  .vs__table thead th {
    position: sticky;
    top: calc(env(safe-area-inset-top, 0px) + var(--site-header-height));
    z-index: 1;
    background: var(--surface-2);
    color: var(--text);
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .vs__table tbody th {
    width: 28%;
    min-width: 8.5rem;
    color: var(--text);
    font-weight: 560;
    letter-spacing: -0.01em;
    background: color-mix(in srgb, var(--surface-2) 55%, transparent);
  }

  .vs__table tbody td {
    color: var(--text-2);
    width: 36%;
  }

  .vs__table tbody tr:last-child th,
  .vs__table tbody tr:last-child td {
    border-bottom: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .vs__table tbody tr:hover td,
    .vs__table tbody tr:hover th {
      background: color-mix(in srgb, var(--pv-violet) 12%, var(--surface));
    }
  }

  .prose h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }

  .prose p {
    color: var(--text-2);
  }

  .vs__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }
</style>
